{
  "name": "lviv-polytechnic-server-catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static server catalog for the Lviv Polytechnic community",
  "scripts": {
    "build": "npm run build:images && npm run build:css && npm run build:static",
    "build:css": "tailwindcss -i ./styles/tailwind.css -o ./index.css --minify",
    "build:images": "node scripts/build-images.js",
    "watch:css": "tailwindcss -i ./styles/tailwind.css -o ./index.css --watch",
    "build:static": "node scripts/build-static.js",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "test": "node --test tests/*.test.js",
    "dev": "wrangler dev"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "wrangler": "4.154.0"
  }
}
